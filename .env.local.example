# For running core-service / shop-service directly on your machine (npm run dev),
# while Postgres and Redis run in Docker:
#   docker compose up -d core-db shop-db redis
#   cp .env.local.example .env.local
# Host ports: core-db 5433, shop-db 5434, redis 6379, core-service 8000.

JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
INTERNAL_API_KEY=dev-internal-key-change-me
REDIS_URL=redis://localhost:6379/0
EVENTS_STREAM=events
LOG_LEVEL=debug

CORE_DATABASE_URL=postgresql://core:core@localhost:5433/core_db
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

SHOP_DATABASE_URL=postgresql://shop:shop@localhost:5434/shop_db
CORE_SERVICE_URL=http://localhost:8000
