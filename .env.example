# Copy to .env and change the secrets for anything other than local development.
#   cp .env.example .env
# docker-compose.yml has the same values as defaults, so .env is optional locally.

# --- shared by both services (MUST be identical in core-service and shop-service) ---
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
INTERNAL_API_KEY=dev-internal-key-change-me
REDIS_URL=redis://redis:6379/0
EVENTS_STREAM=events
LOG_LEVEL=info

# --- core-service / core-worker ---
CORE_DATABASE_URL=postgresql://core:core@core-db:5432/core_db
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# 1 = load demo products/users/orders on first start (skipped if products exist)
SEED_DEMO_DATA=1

# --- shop-service ---
SHOP_DATABASE_URL=postgresql://shop:shop@shop-db:5432/shop_db
CORE_SERVICE_URL=http://core-service:8000

# --- frontend (baked in at build time) ---
# false = use the real backend through the gateway, true = JSON mock data only
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=http://localhost/api
