{
  "name": "@threads/shop-service",
  "version": "1.0.0",
  "private": true,
  "description": "Cart, checkout and mock payments; publishes payment.succeeded, consumes order.shipped",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=../../.env.local src/server.ts",
    "migrate:dev": "node --env-file=../../.env.local ../../node_modules/prisma/build/index.js migrate dev",
    "studio": "node --env-file=../../.env.local ../../node_modules/prisma/build/index.js studio",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@threads/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "opossum": "^8.1.4",
    "prisma": "^6.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/opossum": "^8.1.8",
    "tsx": "^4.20.0"
  }
}
